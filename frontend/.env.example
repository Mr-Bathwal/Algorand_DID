# Copy to frontend/.env and fill in your own values. NEVER commit the real .env.
# NOTE: every VITE_* value is bundled into the client and is publicly visible —
# only put values here that are safe to expose. Anything truly secret (Pinata
# API secret, backend keys) belongs on a server, not in the frontend.

# ── Firebase (client config — safe to expose, but lock down with rules) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Backend (for Algorand integration) ──
VITE_BACKEND_URL=http://localhost:8787
VITE_BACKEND_API_KEY=

# ── Algorand ──
VITE_ALGO_NETWORK=testnet
VITE_ALGOD_MAINNET_URL=https://mainnet-api.algonode.cloud
VITE_ALGOD_TESTNET_URL=https://testnet-api.algonode.cloud
VITE_ALGOD_TOKEN=

# ── Pinata / IPFS ──
# Prefer a scoped, short-lived JWT. Do NOT ship your account API secret to the client.
VITE_PINATA_JWT=
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud

# ── WalletConnect (public project id) ──
VITE_WALLETCONNECT_PROJECT_ID=

NODE_ENV=development
