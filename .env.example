# Copy to .env and fill in your own values. NEVER commit the real .env.

# Algod node (e.g. AlgoNode public TestNet endpoint — no token needed there)
ALGOD_ADDRESS=https://testnet-api.algonode.cloud
ALGOD_TOKEN=

# 25-word mnemonic of the DEPLOYER account. KEEP THIS SECRET.
# Use a dedicated, low-value TestNet account — never a personal/main account.
DEPLOYER_MNEMONIC=your twenty five word algorand mnemonic goes here ...
